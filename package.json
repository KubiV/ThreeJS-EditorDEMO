{
  "name": "mediawiki-3d-editor",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Interaktivní 3D prohlížeč a editor modelů pro MediaWiki",
  "repository": {
    "type": "git",
    "url": "https://github.com/KubiV/ThreeJS-EditorDEMO.git"
  },
  "scripts": {
    "dev": "node server.js --dev",
    "wiki": "php -S localhost:8000 -t mediawiki-1.41.1 mediawiki-1.41.1/maintenance/dev/includes/router.php",
    "start": "node server.js",
    "build": "npm run generate:icons && vite build",
    "preview": "vite preview",
    "generate:icons": "node scripts/generate-favicons.mjs",
    "build:anatomy": "node scripts/build-anatomy-data.mjs",
    "release:patch": "npm version patch && git push && git push --tags",
    "release:minor": "npm version minor && git push && git push --tags",
    "release:major": "npm version major && git push && git push --tags"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "express": "^4.21.2",
    "meshoptimizer": "^1.2.0",
    "multer": "^2.0.2",
    "sharp": "^0.35.4",
    "three": "^0.165.0"
  },
  "devDependencies": {
    "vite": "^6.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}

