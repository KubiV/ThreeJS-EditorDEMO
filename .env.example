# URL k Action API, například http://localhost:8000/api.php
MW_API_URL=

# Prázdná hodnota publikuje do hlavního prostoru; "3D" vytvoří 3D:Název článku.
MW_PAGE_PREFIX=3D

# Veřejná základní adresa samostatného úložiště 3D souborů. Relativní cesta
# uvedená ve file="…" v článku 3D: se doplní za tuto adresu.
MODEL_STORAGE_URL=/storage/models

# Volitelné přepsání názvu katalogu kategorií a odkazů, které viewer zobrazí.
MW_CATEGORY_PAGE=3D:Kategorie
MW_INFO_PAGE_URL=
MW_LOGIN_URL=

# Bot password vytvořený v MediaWiki. Tyto údaje zůstávají pouze na serveru.
MW_BOT_USERNAME=
MW_BOT_PASSWORD=
